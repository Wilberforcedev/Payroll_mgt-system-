NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://payroll_user:change_me@localhost:5432/payroll
DATABASE_SSL=false
SESSION_SECRET=replace_with_at_least_32_random_characters
DB_POOL_MAX=10

# Required only when the database has no users. Remove after first startup.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_14_characters
